# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5347
API_PREFIX=/api/v1

# MongoDB — replace with your own connection string.
# Special characters in the password MUST be percent-encoded (@ -> %40, # -> %23, / -> %2F).
MONGODB_URI=mongodb://localhost:27017/alpha
REDIS_URL=redis://localhost:6379

# ─── JWT (RSA keypair, paths relative to packages/backend) ─────────────────
# Generate with: openssl genrsa -out keys/jwt-access-private.pem 2048
#                openssl rsa -in keys/jwt-access-private.pem -pubout -out keys/jwt-access-public.pem
JWT_ACCESS_PRIVATE_KEY=keys/jwt-access-private.pem
JWT_ACCESS_PUBLIC_KEY=keys/jwt-access-public.pem
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-in-prod
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── CORS (comma-separated list) ──────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:8175,http://localhost:8080

# ─── S3 (optional in dev, required in production) ─────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── SMTP (optional in dev, required in production) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alpha.local

# ─── Stripe (optional until payments are wired up) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Razorpay (real payments — set both to enable live checkout) ──────────
# Get keys: Razorpay dashboard → Settings → API Keys (use test keys first).
# When unset, payments fall back to the demo gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
